{
  "name": "@clipforge/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the ClipForge FastAPI OpenAPI schema. Do not edit src/schema.ts by hand.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
