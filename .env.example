# --- API / workers ---
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge@postgres:5432/clipforge
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clipforge
ANTHROPIC_API_KEY=<your-key>
LLM_MODEL=claude-sonnet-5-5
WHISPER_MODEL=large-v3
# cuda | cpu | auto
WHISPER_DEVICE=auto
# Model used when transcription runs on CPU (large-v3 is very slow without a GPU)
WHISPER_CPU_MODEL=small
MAX_UPLOAD_GB=4
MAX_DURATION_MIN=180
# Generate with `openssl rand -hex 32` (or run `make env`)
JWT_SECRET=<generate>
CORS_ORIGINS=http://localhost:3000
# Set true when the API is served over HTTPS
AUTH_COOKIE_SECURE=false
# Max projects a user can create per window
PROJECT_CREATE_LIMIT=20
PROJECT_CREATE_WINDOW_S=3600
LOG_LEVEL=INFO

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
